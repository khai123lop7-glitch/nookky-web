# Sao chép file này thành .env.local để chạy thử ở máy local (npm run dev).
# Trên Vercel: vào Project Settings -> Environment Variables và nhập từng
# biến bên dưới. KHÔNG commit file .env hoặc .env.local có giá trị thật.

# ==============================================================================
# 1. GHI ĐƠN HÀNG VÀO GOOGLE SHEET & TRA CỨU ("DATABASE" TẠM THỜI)
# ==============================================================================
# Xem hướng dẫn tạo Service Account + lấy các giá trị này trong README,
# mục "Ghi đơn hàng vào Google Sheet". Phục vụ lưu đơn và Chatbot tra cứu thực tế.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Orders

# ==============================================================================
# 2. THÔNG BÁO TỨC THỜI CHO CHỦ SHOP KHI CÓ ĐƠN / KHÁCH BÁO ĐÃ CHUYỂN TIỀN
# ==============================================================================
# Chỉ cần cấu hình kênh nào bạn muốn dùng, thiếu biến nào thì kênh đó tự bỏ qua.

# Telegram bot (khuyến nghị dùng trước vì setup nhanh, không cần duyệt)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Zalo OA (Official Account) - lưu ý giới hạn 7 ngày tương tác, xem lib/notify.ts
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_NOTIFY_USER_ID=

# ==============================================================================
# 3. GOOGLE ANALYTICS 4 (GA4) - BROWSER & MEASUREMENT PROTOCOL
# ==============================================================================
# Measurement ID cho Browser Tracking (lấy trong GA4 Admin -> Data Streams -> Web)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# API Secret cho Server-side Measurement Protocol (lấy trong Web Stream -> Measurement Protocol API secrets)
GA4_API_SECRET=

# ==============================================================================
# 4. META (FACEBOOK) PIXEL & CONVERSIONS API (CAPI)
# ==============================================================================
# Pixel ID cho trình duyệt (lấy trong Meta Events Manager -> Settings)
NEXT_PUBLIC_META_PIXEL_ID=

# Token truy cập Conversions API cho Server-side (lấy trong Events Manager -> Settings -> Generate access token)
META_CAPI_ACCESS_TOKEN=

# Mã kiểm thử sự kiện (tùy chọn, lấy từ tab Test Events trong Meta Events Manager)
META_TEST_EVENT_CODE=

# ==============================================================================
# 5. TIKTOK PIXEL & EVENTS API
# ==============================================================================
# Pixel ID cho trình duyệt (lấy trong TikTok Ads Manager -> Assets -> Events -> Web Events)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Access Token cho TikTok Events API Server-side (lấy trong TikTok Events Manager -> Settings)
TIKTOK_EVENTS_API_ACCESS_TOKEN=

# ==============================================================================
# 6. AI CHATBOT (TƯ VẤN SẢN PHẨM & TRA CỨU ĐƠN HÀNG THỰC TẾ)
# ==============================================================================
# Cấu hình API key cho mô hình AI (Khuyến nghị OpenAI gpt-4o-mini vì phản hồi nhanh và chi phí cực thấp)
# Nếu không cấu hình, hệ thống sẽ tự động chuyển sang Native Fallback Engine thông minh mà không làm lỗi ứng dụng.
OPENAI_API_KEY=
